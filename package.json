{
  "name": "project-realism",
  "version": "0.1.0",
  "private": true,
  "description": "PROJECT REALISM: a browser tactical shooter in the style of Project Reality. Insurgency: US Army vs Insurgents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "models": "bash scripts/build-models.sh",
    "navmesh": "bash scripts/navmesh.sh",
    "audio": "python3 scripts/build-audio.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@recast-navigation/three": "0.43.1",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "recast-navigation": "0.43.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "0.186.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
